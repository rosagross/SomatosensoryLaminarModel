@article{niemiForeperiodSimpleReaction1981,
	title = {Foreperiod and simple reaction time},
	volume = {89},
	issn = {1939-1455},
	doi = {10.1037/0033-2909.89.1.133},
	abstract = {Reviews studies of simple visual and auditory reaction processes published since W. H. Teicher (1954), with emphasis on the preparatory phase of these processes, particularly the foreperiod ({FP}). The 1st section consists of the analysis of actual {FP} variables; duration, regularity, range, distribution, and preceding {FPs}. The 2nd section deals with factors affecting the relation between {FP} and reaction time ({RT}): (a) the modality, intensity, probability, and duration of the warning signal and reaction stimulus ({RS}) and (b) the speed–accuracy trade-off. It is suggested that the S's expectancy (momentary probability of the immediate delivery of the {RS}) is the most important determinant of the preparation to respond to the {RS} at any moment during a trial and, hence, of {RT}. Many factors exert their influence on preparation through their effect on expectancy. Other factors have a direct influence on preparation: short-term exhaustion and fatigue, immediate arousal evoked by intense auditory stimuli, the S's stimulus criterion, the speed–accuracy trade-off, and fluctuation in motor preparedness owing to inaccuracies in the control of motor preparation. (4½ p ref) ({PsycINFO} Database Record (c) 2016 {APA}, all rights reserved)},
	pages = {133--162},
	number = {1},
	journaltitle = {Psychological Bulletin},
	publisher = {American Psychological Association},
	author = {Niemi, Pekka and Näätänen, Risto},
	date = {1981},
	note = {Place: {US}},
	keywords = {Reaction Time, Expectations, Intertrial Interval, Literature Review, Response Latency, Response Set, Stimulus Duration, Stimulus Presentation Methods},
	file = {Full Text PDF:/data/u_grossmannr_software/Zotero/storage/IA4NW89G/Niemi und Näätänen - 1981 - Foreperiod and simple reaction time.pdf:application/pdf;Snapshot:/data/u_grossmannr_software/Zotero/storage/5HVU3W8U/1981-04682-001.html:text/html},
}

@article{hanadaNumbsenseShapeTexture2021a,
	title = {Numbsense of shape, texture, and objects after left parietal infarction: A case report},
	volume = {15},
	issn = {1748-6645},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8247339/},
	doi = {10.1111/jnp.12229},
	shorttitle = {Numbsense of shape, texture, and objects after left parietal infarction},
	abstract = {Numbsense is a phenomenon, wherein patients can correctly respond to somatosensory stimuli at a higher rate than expected by chance, but cannot perceive the same stimuli consciously. Previously, numbsense has been reported in tactile localization of stimuli on the patient’s own body. Here, we describe a patient with numbsense that involved touched objects. The patient could not recognize the majority of somatosensory stimuli after left parietal infarction, but could correctly select shape, texture, and object stimuli more frequently than expected by chance.},
	pages = {204--214},
	number = {2},
	journaltitle = {Journal of Neuropsychology},
	shortjournal = {J Neuropsychol},
	author = {Hanada, Keisuke and Yokoi, Kayoko and Futamura, Akinori and Kinoshita, Yuji and Sakamoto, Kazutaka and Ono, Kenjiro and Hirayama, Kazumi},
