@article{dehaanUsefulnessWhatWhere2011,
	title = {On the usefulness of 'what' and 'where' pathways in vision},
	volume = {15},
	issn = {13646613},
	url = {/record/2011-22065-006},
	doi = {10.1016/J.TICS.2011.08.005},
	abstract = {The primate visual brain is classically portrayed as a large number of separate 'maps', each dedicated to the processing of specific visual cues, such as colour, motion or faces and their many features. In order to understand this fractionated architecture, the concept of cortical 'pathways' or 'streams' was introduced. In the currently prevailing view, the different maps are organised hierarchically into two major pathways, one involved in recognition and memory (the ventral stream or 'what' pathway) and the other in the programming of action (the dorsal stream or 'where' pathway). In this review, we question this heuristically influential but potentially misleading linear hierarchical pathway model and argue instead for a 'patchwork' or network model. © 2011 Elsevier Ltd.},
	pages = {460--466},
	number = {10},
	journaltitle = {Trends in Cognitive Sciences},
	author = {de Haan, Edward H.F. and Cowey, Alan},
	urldate = {2022-11-06},
	date = {2011-10},
	file = {PDF:/data/u_grossmannr_software/Zotero/storage/7LF62366/de Haan & Cowey (2011) What & Where. TICS.pdf:application/pdf},
}

@article{blouinReferenceSystemsCoding1993,
	title = {Reference systems for coding spatial information in normal subjects and a deafferented patient},
	volume = {93},
	issn = {1432-1106},
	url = {https://link.springer.com/article/10.1007/BF00228401},
	doi = {10.1007/BF00228401},
	abstract = {To produce accurate goal-directed arm movements, subjects must determine the precise location of target object. Position of extracorporeal objects can be determined using: (a) an egocentric frame of reference, in which the target is localized in relation to the position of the body; and/or (b) an allocentric system, in which target position is determined in relation to stable visual landmarks surrounding the target (Bridgeman 1989; Paillard 1991). The present experiment was based on the premise that (a) the presence of a structured visual environment enables the use of an allocentric frame of reference, and (b) the sole presence of a visual target within a homogeneous background forces the registration of the target location by an egocentric system. Normal subjects and a deafferented patient (i.e., with an impaired egocentric system) pointed to visual targets presented in both visual environments to evaluate the efficiency of the two reference systems. For normals, the visual environment conditions did not affect pointing accuracy. However, kinematic parameters were affected by the presence or absence of a structured visual surrounding. For the deafferented patient, the presence of a structured visual environment permitted a decrease in spatial errors when compared with the unstructured surrounding condition (for movements with or without visual feedback of the trajectory). Overall, results support the existence of an egocentric and an allocentric reference system capable of organizing extracorporeal space during arm movements directed toward visual targets.},
	pages = {324--331},
	number = {2},
	journaltitle = {Experimental Brain Research 1993 93:2},
	publisher = {Springer},
	author = {Blouin, J. and Bard, C. and Teasdale, N. and Paillard, J. and Fleury, M. and Forget, R. and Lamarre, Y.},
	urldate = {2022-11-05},
	date = {1993},
	keywords = {Neurosciences, Neurology, Reaching movements, Reference systems, Spatial processing},
	file = {PDF:/data/u_grossmannr_software/Zotero/storage/FWLG9LFL/full-text.pdf:application/pdf},
}

