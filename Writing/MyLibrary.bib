@article{fujisakiFeaturebasedProcessingAudiovisual2007,
	title = {Feature-based processing of audio-visual synchrony perception revealed by random pulse trains},
	volume = {47},
	issn = {00426989},
	doi = {10.1016/j.visres.2007.01.021},
	abstract = {Computationally, audio-visual temporal synchrony detection is analogous to visual motion detection in the sense that both solve the correspondence problem. We examined whether audio-visual synchrony detection is mediated by a mechanism similar to low-level motion sensors, by one similar to a higher-level feature matching process, or by both types of mechanisms as in the case of visual motion detection. We found that audio-visual synchrony-asynchrony discrimination for temporally dense random pulse trains was difficult, whereas motion detection is known to be easy for spatially dense random dot patterns (random dot kinematograms) due to the operation of low-level motion sensors. Subsequent experiments further indicated that the temporal limiting factor of audio-visual synchrony discrimination is the temporal density of salient features not the temporal frequency of the stimulus, nor the physical density of the stimulus. These results suggest that audio-visual synchrony perception is based solely on a salient feature matching mechanism similar to that proposed for high-level visual motion detection. © 2007 Elsevier Ltd. All rights reserved.},
	pages = {1075--1093},
	number = {8},
	journaltitle = {Vision Research},
	author = {Fujisaki, Waka and Nishida, Shin'ya},
	date = {2007},
	keywords = {Audio-visual, Correspondence problem, Saliency based matching, Temporal crowding, Temporal synchrony},
}

