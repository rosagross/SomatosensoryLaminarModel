	author = {Ma, Q. P. and Yin, G. F. and Ai, M. K. and Han, J. S.},
	urldate = {2023-05-08},
	date = {1991-12-16},
	langid = {english},
	keywords = {amygdala, serotonin, horseradish peroxidase, immunocytochemistry, Nucleus raphe dorsalis},
