	volume = {132},
	issn = {0020-0255},
	url = {https://www.sciencedirect.com/science/article/pii/S0020025501000627},
	doi = {10.1016/S0020-0255(01)00062-7},
	abstract = {This paper studies the existence of temporal diversity among cells in a neural network model of the somatosensory cortex. The model is based on extensive experimental observations of actual cell behavior. Phase space and Poincare section plots of time series data generated from the model show intricate dynamics. Using spectral analysis, we show that system follows quasiperiodic route to chaos. The dynamics of the system is summarized by constructing a bifurcation diagram and by determination of the Lyapunov exponent.},
