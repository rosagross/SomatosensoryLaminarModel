	doi = {10.1016/S1053-8100(02)00031-4},
	abstract = {Pockett (2002) has drawn an alternative conclusion from the data of Libet, Alberts, Wright, and Feinstein (1967), and suggested that it takes 80 ms, rather than 500 ms, for the sensation evoked by a stimulus to enter awareness. Here, I suggest that our conscious sensation evolves over time, during the period from 80 to 500 ms after a stimulus, until the sensation is stably localized in space.},
