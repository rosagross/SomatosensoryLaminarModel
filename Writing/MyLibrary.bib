@article{vastanoMaladaptiveReorganizationFollowing2022,
	title = {Maladaptive reorganization following {SCI}: The role of body representation and multisensory integration},
	volume = {208},
	issn = {18735118},
	doi = {10.1016/j.pneurobio.2021.102179},
	abstract = {In this review we focus on maladaptive brain reorganization after spinal cord injury ({SCI}), including the development of neuropathic pain, and its relationship with impairments in body representation and multisensory integration. We will discuss the implications of altered sensorimotor interactions after {SCI} with and without neuropathic pain and possible deficits in multisensory integration and body representation. Within this framework we will examine published research findings focused on the use of bodily illusions to manipulate multisensory body representation to induce analgesic effects in heterogeneous chronic pain populations and in {SCI}-related neuropathic pain. We propose that the development and intensification of neuropathic pain after {SCI} is partly dependent on brain reorganization associated with dysfunctional multisensory integration processes and distorted body representation. We conclude this review by suggesting future research avenues that may lead to a better understanding of the complex mechanisms underlying the sense of the body after {SCI}, with a focus on cortical changes.},
	pages = {102179},
	journaltitle = {Progress in Neurobiology},
	publisher = {Elsevier Ltd},
	author = {Vastano, Roberta and Costantini, Marcello and Widerstrom-Noga, Eva},
	urldate = {2022-09-06},
	date = {2022-01-01},
	keywords = {★, Bodily illusions, Body representation, Multisensory integration, Neuropathic pain, Spinal cord injury},
	file = {PDF:/data/u_grossmannr_software/Zotero/storage/V493BYKL/full-text.pdf:application/pdf},
}

