
@article{azanonMultimodalContributionsBody2016,
	title = {Multimodal Contributions to Body Representation},
	volume = {29},
	issn = {2213-4808},
	url = {https://brill.com/view/journals/msr/29/6-7/article-p635_6.xml},
	doi = {10.1163/22134808-00002531},
	abstract = {Our body is a unique entity by which we interact with the external world. Consequently, the way we represent our body has profound implications in the way we process and locate sensations and in turn perform appropriate actions. The body can be the subject, but also the object of our experience, providing information from sensations on the body surface and viscera, but also knowledge of the body as a physical object. However, the extent to which different senses contribute to constructing the rich and unified body representations we all experience remains unclear. In this review, we aim to bring together recent research showing important roles for several different sensory modalities in constructing body representations. At the same time, we hope to generate new ideas of how and at which level the senses contribute to generate the different levels of body representations and how they interact. We will present an overview of some of the most recent neuropsychological evidence about multisensory control of pain, and the way that visual, auditory, vestibular and tactile systems contribute to the creation of coherent representations of the body. We will focus particularly on some of the topics discussed in the symposium on Multimodal Contributions to Body Representation held on the 15th International Multisensory Research Forum (2015, Pisa, Italy).},
	pages = {635--661},
	number = {6},
	journaltitle = {Multisensory Research},
	publisher = {Brill},
	author = {Azanõn, Elena and Tamè, Luigi and Maravita, Angelo and Linkenauger, Sally A. and Ferrè, Elisa R. and Tajadura-Jiménez, Ana and Longo, Matthew R.},
	urldate = {2022-09-29},
	date = {2016-01-01},
	keywords = {★, Biologie, pain, Psychologie, touch, vestibular system, vision, Zeitschrift},
	file = {PDF:/data/u_grossmannr_software/Zotero/storage/8HQVFQNH/full-text.pdf:application/pdf},
}

@article{acharyaMirrorNeuronsEnigma2012,
	title = {Mirror neurons: Enigma of the metaphysical modular brain},
	volume = {3},
	issn = {09769668},
	url = {/pmc/articles/PMC3510904/},
	doi = {10.4103/0976-9668.101878},
	abstract = {Mirror neurons are one of the most important discoveries in the last decade of neuroscience. These are a variety of visuospatial neurons which indicate fundamentally about human social interaction. Essentially, mirror neurons respond to actions that we observe in others. The interesting part is that mirror neurons fire in the same way when we actually recreate that action ourselves. Apart from imitation, they are responsible for myriad of other sophisticated human behavior and thought processes. Defects in the mirror neuron system are being linked to disorders like autism. This review is a brief introduction to the neurons that shaped our civilization.},
	pages = {118},
	number = {2},
	journaltitle = {Journal of Natural Science, Biology, and Medicine},
	publisher = {Wolters Kluwer -- Medknow Publications},
	author = {Acharya, Sourya and Shukla, Samarth},
	urldate = {2022-10-19},
	date = {2012-07},
	keywords = {Autism, neurons, visuospatial},
	file = {PDF:/data/u_grossmannr_software/Zotero/storage/Z8EBGSTN/full-text.pdf:application/pdf},
}

@article{alderson-dayBrainConversationItself2015,
	title = {The brain's conversation with itself: Neural substrates of dialogic inner speech},
	volume = {11},
	issn = {17495024},
	doi = {10.1093/scan/nsv094},
	abstract = {Inner speech has been implicated in important aspects of normal and atypical cognition, including the development of auditory hallucinations. Studies to date have focused on covert speech elicited by simple word or sentence repetition, while ignoring richer and arguably more psychologically significant varieties of inner speech. This study compared neural activation for inner speech involving conversations ('dialogic inner speech') with single-speaker scenarios ('monologic inner speech'). Inner speech-related activation differences were then compared with activations relating to Theory-of-Mind ({ToM}) reasoning and visual perspective-taking in a conjunction design. Generation of dialogic (compared with monologic) scenarios was associated with a widespread bilateral network including left and right superior temporal gyri, precuneus, posterior cingulate and left inferior and medial frontal gyri. Activation associated with dialogic scenarios and {ToM} reasoning overlapped in areas of right posterior temporal cortex previously linked to mental state representation. Implications for understanding verbal cognition in typical and atypical populations are discussed.},
	pages = {110--120},
	number = {1},
	journaltitle = {Social Cognitive and Affective Neuroscience},
	author = {Alderson-Day, Ben and Weis, Susanne and {McCarthy}-Jones, Simon and Moseley, Peter and Smailes, David and Fernyhough, Charles},
	date = {2015},
	keywords = {Auditory verbal hallucinations, Covert speech, Dialogue, {fMRI}, Monologue},
}

