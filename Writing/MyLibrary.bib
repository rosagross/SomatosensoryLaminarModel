	volume = {241},
	issn = {1432-1106},
	url = {https://doi.org/10.1007/s00221-023-06579-9},
	doi = {10.1007/s00221-023-06579-9},
	shorttitle = {Modulation of somatosensation by transcranial magnetic stimulation over somatosensory cortex},
	abstract = {Over the last three decades, transcranial magnetic stimulation ({TMS}) has gained popularity as a tool to modulate human somatosensation. However, the effects of different stimulation types on the multiple distinct subdomains of somatosensation (e.g., tactile perception, proprioception and pain) have not been systematically compared. This is especially notable in the case of newer theta-burst stimulation protocols now in widespread use. Here, we aimed to systematically and critically review the existing {TMS} literature and provide a complete picture of current knowledge regarding the role of {TMS} in modulating human somatosensation across stimulation protocols and somatosensory domains. Following the {PRISMA} guidelines, fifty-four studies were included in the current review and were compared based on their methodologies and results. Overall, findings from these studies provide evidence that different types of somatosensation can be both disrupted and enhanced by targeted stimulation of specific somatosensory areas. Some mixed results, however, were reported in the literature. We discussed possible reasons for these mixed results, methodological limitations of existing investigations, and potential avenues for future research.},
	pages = {951--977},
	number = {4},
	journaltitle = {Experimental Brain Research},
	shortjournal = {Exp Brain Res},
	author = {Tang, Ding-lan and Niziolek, Caroline A. and Parrell, Benjamin},
	urldate = {2023-09-01},
	date = {2023-04-01},
	langid = {english},
	keywords = {Proprioception, Transcranial magnetic stimulation, Somatosensory cortex, Somatosensory processing, Tactile perception},
	file = {Full Text PDF:/data/u_grossmannr_software/Zotero/storage/UQM5SZGU/Tang et al. - 2023 - Modulation of somatosensation by transcranial magn.pdf:application/pdf},
}

