@article{larkumCellularMechanismCortical2013,
	title = {A cellular mechanism for cortical associations: an organizing principle for the cerebral cortex},
	volume = {36},
	issn = {0166-2236},
	url = {https://www.sciencedirect.com/science/article/pii/S0166223612002032},
	doi = {10.1016/j.tins.2012.11.006},
	shorttitle = {A cellular mechanism for cortical associations},
	abstract = {A basic feature of intelligent systems such as the cerebral cortex is the ability to freely associate aspects of perceived experience with an internal representation of the world and make predictions about the future. Here, a hypothesis is presented that the extraordinary performance of the cortex derives from an associative mechanism built in at the cellular level to the basic cortical neuronal unit: the pyramidal cell. The mechanism is robustly triggered by coincident input to opposite poles of the neuron, is exquisitely matched to the large- and fine-scale architecture of the cortex, and is tightly controlled by local microcircuits of inhibitory neurons targeting subcellular compartments. This article explores the experimental evidence and the implications for how the cortex operates.},
	pages = {141--151},
	number = {3},
	journaltitle = {Trends in Neurosciences},
	shortjournal = {Trends in Neurosciences},
	author = {Larkum, Matthew},
	urldate = {2024-05-22},
	date = {2013-03-01},
	keywords = {feedback, pyramidal neuron, binding, calcium spike, dendrite, neocortex},
	file = {Larkum - 2013 - A cellular mechanism for cortical associations an.pdf:/data/u_grossmannr_software/Zotero/storage/9XR6ICP8/Larkum - 2013 - A cellular mechanism for cortical associations an.pdf:application/pdf;ScienceDirect Snapshot:/data/u_grossmannr_software/Zotero/storage/B7VSB5CL/S0166223612002032.html:text/html},
}

@article{reimannNullModelMouse2019,
	title = {A null model of the mouse whole-neocortex micro-connectome},
	volume = {10},
	rights = {2019 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-019-11630-x},
	doi = {10.1038/s41467-019-11630-x},
	abstract = {In connectomics, the study of the network structure of connected neurons, great advances are being made on two different scales: that of macro- and meso-scale connectomics, studying the connectivity between populations of neurons, and that of micro-scale connectomics, studying connectivity between individual neurons. We combine these two complementary views of connectomics to build a first draft statistical model of the micro-connectome of a whole mouse neocortex based on available data on region-to-region connectivity and individual whole-brain axon reconstructions. This process reveals a targeting principle that allows us to predict the innervation logic of individual axons from meso-scale data. The resulting connectome recreates biological trends of targeting on all scales and predicts that an established principle of scale invariant topological organization of connectivity can be extended down to the level of individual neurons. It can serve as a powerful null model and as a substrate for whole-brain simulations.},
	pages = {3903},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Reimann, Michael W. and Gevaert, Michael and Shi, Ying and Lu, Huanxiang and Markram, Henry and Muller, Eilif},
	urldate = {2024-05-21},
	date = {2019-08-29},
	langid = {english},
	keywords = {Neural circuits, Network models},
	file = {Full Text PDF:/data/u_grossmannr_software/Zotero/storage/F7YXZZUC/Reimann et al. - 2019 - A null model of the mouse whole-neocortex micro-co.pdf:application/pdf},
}

@article{takahashiActiveCorticalDendrites2016a,
	title = {Active cortical dendrites modulate perception},
	volume = {354},
	url = {https://www.science.org/doi/10.1126/science.aah6066},
	doi = {10.1126/science.aah6066},
	abstract = {There is as yet no consensus concerning the neural basis of perception and how it operates at a mechanistic level. We found that Ca2+ activity in the apical dendrites of a subset of layer 5 (L5) pyramidal neurons in primary somatosensory cortex (S1) in mice is correlated with the threshold for perceptual detection of whisker deflections. Manipulating the activity of apical dendrites shifted the perceptual threshold, demonstrating that an active dendritic mechanism is causally linked to perceptual detection.},
	pages = {1587--1590},
	number = {6319},
	journaltitle = {Science},
	publisher = {American Association for the Advancement of Science},
