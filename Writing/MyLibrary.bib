@article{grimbertAnalysisJansensModel2006,
	title = {Analysis of Jansen's model of a single cortical column},
	volume = {37},
	rights = {https://journals.sagepub.com/page/policies/text-and-data-mining-license},
	issn = {0759-1063, 2070-2779},
	url = {https://journals.sagepub.com/doi/10.1177/075910639203700105},
	doi = {10.1177/075910639203700105},
	abstract = {In this report we present a mathematical analysis of a simple model of a cortical column. We ﬁrst recall some known biological facts about cortical columns. We then present a mathematical model of such a column, developed by a number of people including Lopes Da Silva, Jansen, Rit. Finally we analyze some aspects of its behaviour in the framework of the theory of dynamical systems using bifurcation theory and the software package {XPP}-Aut developed by B. Ermentrout. This mathematical approach leads us to a compact representation of the model that allows to ﬁnally discuss its adequacy with biology.},
	pages = {55--57},
	number = {1},
